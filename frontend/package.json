{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "5.9.3",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
