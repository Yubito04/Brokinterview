# Copy this file to .env and replace the placeholders.
# Never commit the real .env file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/applyflow
# Used only by the tests. The name must end with _test and differ from the one above:
# the test run drops its tables at the end.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/applyflow_test
# Optional. Without it the app runs, but POST /job-postings/extract answers 503.
# Create a key on console.anthropic.com. Never commit the real .env file.
ANTHROPIC_API_KEY=
# Optional. Web pages allowed to call the API from a browser (CORS), separated by commas.
# Default: the Vite dev server on localhost and on 127.0.0.1 (two different origins).
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
